# Copy to .env (gitignored) and fill in. Every setting is read by src/gen_ai_de/config.py
# from real environment variables first, then from this file.

# --- general (used now) ---
DATA_DIR=data              # local working area: landing files, caches
STORAGE_BACKEND=local      # where ingestion writes: local | (later) databricks_volume | postgres
LOG_LEVEL=INFO

# --- Kaggle (reference datasets; used by ingestion/reference/calories.py) ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- later stages (not read by the code yet) ---
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=
# DATABRICKS_CATALOG=gen_ai_de
# DATABASE_URL=postgresql://user:password@db:5432/gen_ai_de
# TELEGRAM_BOT_TOKEN=
# LLM_API_KEY=
