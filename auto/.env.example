# Copy to .env (git-ignored). Prefix FITLAKE_ maps 1:1 to fitlake.config.Settings.
FITLAKE_ENV=local                 # local | dev | prod
FITLAKE_CATALOG=fitlake_dev
FITLAKE_LANDING_ROOT=./data/landing        # Databricks: /Volumes/<catalog>/bronze/landing
FITLAKE_CHECKPOINT_ROOT=./data/_checkpoints # Databricks: /Volumes/<catalog>/bronze/checkpoints
FITLAKE_USER_AGENT=fitlake-bot/0.1 (+contact: you@example.com)
FITLAKE_NCBI_API_KEY=                      # optional, raises PubMed rate limit
FITLAKE_VS_ENDPOINT=fitlake-vs
FITLAKE_EMBEDDING_ENDPOINT=databricks-gte-large-en
FITLAKE_LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Databricks auth (use OAuth M2M / service principal, not personal tokens, outside local dev)
DATABRICKS_HOST=https://adb-xxxxxxxx.azuredatabricks.net
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx   # SQL warehouse used by the app
FITLAKE_USE_DBCONNECT=0                    # 1 = run Spark code against serverless via Databricks Connect
